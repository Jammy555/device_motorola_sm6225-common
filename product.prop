# App freezer
ro.config.use_freezer=false

# eBPF
ro.bpf.kver_override=5.10.239

# LMKD
ro.lmk.kill_heaviest_task=true
ro.lmk.swap_util_max=90
ro.lmk.thrashing_limit=30
ro.lmk.thrashing_limit_decay=25
ro.lmk.thrashing_limit_critical=30
ro.lmk.psi_complete_stall_ms=120
ro.lmk.psi_partial_stall_ms=50
ro.lmk.filecache_min_kb=300000

# Disable RescueParty due to high risk of data loss
persist.sys.disable_rescue=true

# Motorola
ro.mot.build.customerid=global
ro.vendor.mot.factory=false

# System server
arm64.memtag.process.system_server=off

# Voice assistant
ro.opa.eligible_device=true
